def move_slow(start, end, step=1, delay=0.05):
    if start < end:
        angles = range(start, end + 1, step)
    else:
        angles = range(start, end -1, -step)
    for a in angles:
        set_angle(a)
        sleep(delay)
        
def set_angle(angle):
    pulse = int(500000 + (angle / 180) * 20000000)
    servo.duty_ns(pulse)
    
address = socket.getaddrinfo("0.0.0.0", 80)[0][-1]
server = socket.socket()
server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
server.bind(address)
server.listen(1)


